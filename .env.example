# Copy to .env for local development. Never commit .env.
# The API refuses to start if any value without a default is missing.

APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=debug

# Container Postgres is mapped to 5433 because the host already runs Postgres on 5432.
DATABASE_URL=postgres://nimbus:nimbus_dev_password@localhost:5433/nimbus?sslmode=disable
DATABASE_MAX_CONNS=10

# Generate a real value for production: openssl rand -base64 48
JWT_SECRET=local-development-secret-do-not-use-in-production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# S3-compatible object storage. MinIO locally, Cloudflare R2 in production.
# Path-style addressing is required by MinIO and optional on R2.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nimbus-files
S3_ACCESS_KEY=nimbus_minio
S3_SECRET_KEY=nimbus_minio_dev_password
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL=15m

# free enforces the 10 GB application-level cap; premium disables it. See ADR in the vault.
STORAGE_MODE=free
FREE_STORAGE_LIMIT_BYTES=10737418240

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Integration tests run against their own database, created by db/init/01-test-database.sql
TEST_DATABASE_URL=postgres://nimbus:nimbus_dev_password@localhost:5433/nimbus_test?sslmode=disable

# Phase 11 only. Leave unset until then.
# REDIS_URL=redis://localhost:6379/0
