# Development happens on Windows, CI runs on Linux. Normalising to LF in the repository
# keeps the gofmt check in CI from failing on line endings alone.
* text=auto eol=lf

*.sh   text eol=lf
*.go   text eol=lf
*.sql  text eol=lf
*.yml  text eol=lf
*.md   text eol=lf

# Generated by sqlc: collapse it in diffs, but still review it deliberately.
db/generated/** linguist-generated=true
